# ==============================================================================
# LEARNFLOW LMS — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to backend/.env (or set variables in root .env)
# ==============================================================================

ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/learnflow

# Bootstrap Superadmin Credentials (Initial Production Provisioning)
BOOTSTRAP_ADMIN_EMAIL=admin@institution.edu
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeStrongPassword2026!

# Cryptographic Keys (Change in production)
SECRET_KEY=learnflow-jwt-super-secret-key-production-ready-2026-eval-token
JWT_ISSUER=learnflow-auth-authority
JWT_AUDIENCE=learnflow-api-clients
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
AUTH_RATE_LIMIT_PER_MINUTE=10
COOKIE_SECURE=false

# Certificate HMAC Key Ring
HMAC_ACTIVE_KEY_ID=k1
HMAC_KEY_RING={"k1":"learnflow-hmac-secret-k1-2026-eval-seed-001"}

# Distributed Rate Limiting & Cache (Redis)
REDIS_URL=redis://localhost:6379/0

# Storage Service (Local directory or S3/MinIO)
STORAGE_TYPE=local
MEDIA_ROOT=media
CLEAN_MEDIA_DIR=media/clean
CERTS_DIR=media/certs

# CORS Origins (Comma-separated list or JSON array)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Gemini AI Copilot API Key (Optional)
GEMINI_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash

