# ==========================================
# LEARNFLOW LMS — ENVIRONMENT CONFIGURATION
# ==========================================

# Database Configuration (PostgreSQL 15)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=learnflow
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/learnflow

# Authentication & JWT Secrets
SECRET_KEY=learnflow-jwt-super-secret-key-production-ready-2026-eval-token
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Object Storage (S3Mock / MinIO / AWS S3)
S3_ENDPOINT_URL=http://localhost:9090
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin
S3_BUCKET_NAME=learnflow-storage
S3_QUARANTINE_BUCKET=learnflow-quarantine
S3_REGION=us-east-1

# Mail / SMTP (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@learnflow.edu
SMTP_TLS=false

# Frontend Application
FRONTEND_URL=http://localhost:5173

# AI & LLM Engine (Google Gemini)
# Add your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Frontend Evaluation Mode (Disabled by default)
VITE_ENABLE_DEMO_PERSONAS=false
