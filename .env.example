# ==============================================================================
# LEARNFLOW LMS — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure appropriate values for your environment.
# NEVER commit .env files containing real secrets to version control.
# For production deployments, mandatory secret validation will fail startup if
# default evaluation keys are left unchanged.
# ==============================================================================

# ------------------------------------------------------------------------------
# Runtime Deployment Mode
# ------------------------------------------------------------------------------
# Options: development | staging | production | testing
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# PostgreSQL Database (PostgreSQL 15+)
# ------------------------------------------------------------------------------
# In production, replace user, password, and host with secure credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=learnflow
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/learnflow

# ------------------------------------------------------------------------------
# Production First-Admin Bootstrap (Mandatory for initial production boot)
# ------------------------------------------------------------------------------
# In production, creates the initial superadmin account once if no admin exists.
# Password must be at least 8 characters with upper, lower, digit, and symbol.
BOOTSTRAP_ADMIN_EMAIL=admin@institution.edu
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeStrongPassword2026!

# ------------------------------------------------------------------------------
# Authentication & JWT Cryptography
# ------------------------------------------------------------------------------
# In production, generate a secure random 64-character hex key:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=learnflow-jwt-super-secret-key-production-ready-2026-eval-token
JWT_ISSUER=learnflow-auth-authority
JWT_AUDIENCE=learnflow-api-clients
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
AUTH_RATE_LIMIT_PER_MINUTE=10
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# Certificate HMAC Key Ring
# ------------------------------------------------------------------------------
# Used for cryptographically signing and verifying issued PDF credentials.
# Active key ID must be present in the JSON key ring.
HMAC_ACTIVE_KEY_ID=k1
# In production, inject HMAC_KEY_RING via secure secret manager or JSON string:
# python -c "import secrets; print(secrets.token_hex(32))"
HMAC_KEY_RING={"k1":"learnflow-hmac-secret-k1-2026-eval-seed-001","k2":"learnflow-hmac-secret-k2-2027-prod-seed-002"}

# ------------------------------------------------------------------------------
# Distributed Rate Limiting & Cache (Redis)
# ------------------------------------------------------------------------------
# When omitted or unreachable, gracefully falls back to thread-safe in-memory limiter.
# In multi-replica production deployments, configure Redis:
# REDIS_URL=redis://:strong_redis_password@redis:6379/0
REDIS_URL=

# ------------------------------------------------------------------------------
# S3-Compatible Object Storage (AWS S3, MinIO, or S3Mock)
# ------------------------------------------------------------------------------
S3_ENDPOINT_URL=http://localhost:9090
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin
S3_BUCKET_NAME=learnflow-storage
S3_QUARANTINE_BUCKET=learnflow-quarantine
S3_REGION=us-east-1

# ------------------------------------------------------------------------------
# Email / SMTP Service
# ------------------------------------------------------------------------------
# In local dev: Mailpit runs at localhost:1025 (Web UI at localhost:8025)
# In production: Use Amazon SES, SendGrid, or institutional SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@learnflow.edu
SMTP_TLS=false

# ------------------------------------------------------------------------------
# Web Frontend URL & CORS
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# AI & LLM Engine (Google Gemini API)
# ------------------------------------------------------------------------------
# Obtain API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# Frontend Application Settings (Development Demo Credentials Only)
# ------------------------------------------------------------------------------
# In production, VITE_ENABLE_DEMO_PERSONAS must remain false (or unset).
# Demo personas are populated exclusively when VITE_ENABLE_DEMO_PERSONAS=true.
VITE_ENABLE_DEMO_PERSONAS=false
VITE_API_URL=http://localhost:8000
VITE_DEMO_LEARNER_EMAIL=learner@learnflow.edu
VITE_DEMO_LEARNER_PASSWORD=LearnerPass123!
VITE_DEMO_INSTRUCTOR_EMAIL=instructor@learnflow.edu
VITE_DEMO_INSTRUCTOR_PASSWORD=InstructorPass123!
VITE_DEMO_HOD_EMAIL=hod@learnflow.edu
VITE_DEMO_HOD_PASSWORD=HodPass123!
VITE_DEMO_ADMIN_EMAIL=admin@learnflow.edu
VITE_DEMO_ADMIN_PASSWORD=AdminPass123!
